# yamllint configuration
# See ADR-0011 for code quality tool selection

---
extends: default

rules:
  line-length:
    max: 120
    level: warning

  indentation:
    spaces: 2
    indent-sequences: true

  comments:
    min-spaces-from-content: 1

  comments-indentation: {}

  document-start:
    present: true

  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']

ignore: |
  .github/
  .venv/
  venv/
  build/
  dist/
  htmlcov/
  .claude/
  .ansible/
  changelogs/changelog.yaml
  tests/integration/sample_servers/nodejs-resources/node_modules/
